# NASA Earthdata token — https://urs.earthdata.nasa.gov/profile
# Needs ASF DAAC access approved; GPM IMERG also needs "NASA GESDISC DATA ARCHIVE".
# Not required for discovery (step 1); required from ingestion (step 2) onward.
EARTHDATA_TOKEN=EDL-...

# Optional: where intermediate GeoTIFFs are written (default ./data)
# GAIA_DATA_DIR=./data

# --- Gaia AI (Gemini) ------------------------------------------------------- #
# Key from https://aistudio.google.com/apikey . Stays on the server; the browser never sees it.
# Several keys? Comma-separate them in GEMINI_API_KEYS: GAIA rotates to the next on quota errors.
GEMINI_API_KEY=
# GEMINI_API_KEYS=key-one,key-two
# Model (default gemini-3.8-flash). .env is read at startup: restart the backend after changing it.
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded, rate-limited, slow or unavailable
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Seconds to wait for one model before trying the next (default 25)
# GEMINI_TIMEOUT=25
# Gemini 3 reasoning effort: low (default, fastest), medium, high, or off
# GEMINI_THINKING=low
# The "mask": persona, knowledge (who made GAIA, the NASA Space Apps challenge…) and answer
# templates. Edit gaia/assistant_mask.md, or point this at your own copy. Reloaded on change.
# GAIA_ASSISTANT_MASK=gaia/assistant_mask.md
# Token budget per reply, thinking included (default 2048) and messages per client per 5 minutes (default 20)
# GAIA_ASSISTANT_MAX_TOKENS=2048
# GAIA_ASSISTANT_RATE_LIMIT=20

# --- Supabase storage (optional) -------------------------------------------- #
# Set both to keep monitors, jobs, results, caches and output maps in Supabase instead of data/.
# Create the tables + private bucket first (Supabase CLI v3, from the repo root):
#   npx supabase@3.1.0 login
#   npx supabase@3.1.0 link <project-ref>
#   npx supabase@3.1.0 db push --remote --dry-run     (preview)   then without --dry-run
# Then verify with:  python -m gaia store check   and copy existing data/ with:  python -m gaia store import-local
# Use the SECRET key (Project Settings → API Keys → sb_secret_…), never the publishable/anon key:
# the tables and bucket have RLS on and NO anon/authenticated access, by design. Server-side only —
# never put this key in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Force a backend: local | supabase (default: supabase when both values above are set)
# GAIA_STORE=supabase
# Bucket for output maps (default gaia-outputs, created by the migration)
# SUPABASE_BUCKET=gaia-outputs
